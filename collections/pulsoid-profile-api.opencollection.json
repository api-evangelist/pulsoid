{
  "opencollection": "1.0.0",
  "info": {
    "name": "Pulsoid Features Profile API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Profile",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Read user profile",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://dev.pulsoid.net/api/v1/profile"
          },
          "docs": "Returns the authenticated user's profile information."
        }
      ]
    }
  ],
  "bundled": true
}