{
  "opencollection": "1.0.0",
  "info": {
    "name": "Pulsoid Features API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Features",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Check feature availability",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://dev.pulsoid.net/api/v1/features/:featureId",
            "params": [
              {
                "name": "featureId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Check feature availability"
        }
      ]
    }
  ],
  "bundled": true
}